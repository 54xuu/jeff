{
  "name": "jeff-desktop",
  "productName": "Jeff",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package:dir": "electron-vite build && electron-builder --dir",
    "package:linux": "electron-vite build && electron-builder --linux --x64",
    "package:win": "electron-vite build && electron-builder --win --x64",
    "fetch-opencode": "node scripts/fetch-opencode.mjs",
    "test:e2e": "electron-vite build && playwright test -c e2e/playwright.config.ts --project=ui",
    "test:e2e:live": "electron-vite build && playwright test -c e2e/playwright.config.ts --project=live"
  },
  "dependencies": {
    "@jeff/core": "*",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "39.8.10",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "zustand": "^5.0.2"
  },
  "description": "Jeff — 个人「开发 + 项目管理」agent 桌面应用",
  "author": "jeff",
  "homepage": "https://github.com/54xuu/jeff"
}
